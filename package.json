{
  "name": "@chio/codex-plugin",
  "version": "0.3.0",
  "description": "Chio policy diagnostics and receipts for Codex. Complete kernel mediation is not yet accepted.",
  "type": "module",
  "main": "./dist/cli/main.js",
  "bin": {
    "chio-codex": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    ".codex-plugin",
    "hooks.json",
    "skills",
    "examples",
    "README.md",
    "LICENSE",
    "vendor",
    "RESTRICTED.md",
    "acceptance/2026-09-09",
    "docs/assets",
    "docs/HOOKS.md"
  ],
  "scripts": {
    "build": "tsc && node ./scripts/mark-hooks-executable.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --experimental-strip-types --test ./test/*.test.ts",
    "prepack": "node -e \"throw new Error('Use npm run pack:release for a self-contained staged artifact')\"",
    "pack:release": "node scripts/pack-release.mjs"
  },
  "keywords": [
    "codex",
    "chio",
    "plugin",
    "agent-governance",
    "hooks",
    "receipts",
    "capabilities",
    "passport"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@chio/bridge": "file:vendor/chio-bridge-0.3.0-7d9e34f7408a.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/backbay-labs/chio-codex-plugin.git"
  }
}
